# Copy to `.env` and change values for your local machine.
TRADER_DEV_MODE=true
DEV_MODE=true
VITE_DEV_MODE=true
VITE_API_BASE_URL=http://127.0.0.1:8000
# Set this on the trading PC. Use a long random value and do not commit the real .env.
TRADER_REMOTE_TOKEN=replace-with-a-long-random-secret
# Optional convenience default for the controller PC UI.
VITE_REMOTE_COMMAND_URL=ws://100.x.x.x:8000/remote/ws
# On the trading PC, let `python run.py` expose the receiver to Tailscale.
TRADER_REMOTE_ENABLED=false
